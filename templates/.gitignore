# Python bytecode, test caches, and coverage output.
__pycache__/
*.py[cod]
*$py.class
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Python virtual environments.
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Package and app dependency caches.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/

# Build and distribution output.
build/
dist/
site/
*.egg-info/

# Logs and runtime state generated by local runs.
*.log
*.pid
*.pid.lock
*.tmp
tmp/
runtime/

# Local environment and secret-bearing config files. Keep examples trackable.
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.*
!*.local.example

# Local reports and generated audit output.
reports/

# Editor workspace files and swap/backup files.
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata.
.DS_Store
Thumbs.db

