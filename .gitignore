# Python bytecode, test caches, and coverage output.
__pycache__/
*.py[cod]
*$py.class
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Python virtual environments, wherever a script creates one.
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Logs and runtime state generated by local script runs.
*.log
*.pid
*.pid.lock
*.tmp
get-docker.sh

# Local environment and secret-bearing config files. Keep examples trackable.
.env
.env.*
!.env.example
!.env.*.example
scripts/weather-alert/config.json
scripts/weather-alert/config.local.json
scripts/weather-alert/config.js
!scripts/weather-alert/config.example.json

# Local reports generated by audit scripts. Keep docs/ available for committed documentation.
/reports/

# Editor workspace files and swap/backup files.
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata.
.DS_Store
Thumbs.db
